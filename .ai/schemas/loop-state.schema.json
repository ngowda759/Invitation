{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invitation.local/schemas/loop-state.schema.json",
  "title": "Invitation loop state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updatedAt",
    "status",
    "currentTaskId",
    "round",
    "maxReviewRounds",
    "currentPr",
    "reviewedHeadSha",
    "lastVerdict",
    "lastCiStatus",
    "blockedReason",
    "lastMerge",
    "nextTask",
    "completedTasks",
    "history"
  ],
  "properties": {
    "version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IMPLEMENTING",
        "TESTING",
        "ANTISLOP_REVIEW",
        "CHATGPT_REVIEW",
        "FIX_REQUIRED",
        "REVALIDATING",
        "APPROVED",
        "MERGED",
        "NEXT_PHASE"
      ]
    },
    "currentTaskId": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "round": { "type": "integer", "minimum": 0 },
    "maxReviewRounds": { "type": "integer", "minimum": 1 },
    "currentPr": { "type": ["integer", "null"], "minimum": 1 },
    "reviewedHeadSha": { "type": ["string", "null"] },
    "lastVerdict": { "type": ["string", "null"], "enum": ["PASS", "FAIL", null] },
    "lastCiStatus": { "type": ["string", "null"] },
    "blockedReason": { "type": ["string", "null"] },
    "lastMerge": {
      "type": ["object", "null"],
      "description": "Verified merge evidence for the most recently reconciled task.",
      "additionalProperties": false,
      "required": ["taskId", "prNumber", "headSha", "mergeCommit", "mergedAt", "reconciledAt"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
        "prNumber": { "type": "integer", "minimum": 1 },
        "headSha": { "type": "string", "minLength": 1 },
        "mergeCommit": { "type": "string", "minLength": 1 },
        "mergedAt": { "type": "string", "format": "date-time" },
        "reconciledAt": { "type": "string", "format": "date-time" },
        "ciStatus": { "type": "string" }
      }
    },
    "nextTask": {
      "type": ["object", "null"],
      "description": "State of next-task generation after a merge: requested, applied or failed.",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["requested", "applied", "failed"] },
        "taskId": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
        "requestedAt": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "completedTasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "from", "to", "note"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from": { "type": ["string", "null"] },
          "to": {
            "enum": [
              "PLANNED",
              "READY",
              "IMPLEMENTING",
              "TESTING",
              "ANTISLOP_REVIEW",
              "CHATGPT_REVIEW",
              "FIX_REQUIRED",
              "REVALIDATING",
              "APPROVED",
              "MERGED",
              "NEXT_PHASE"
            ]
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
