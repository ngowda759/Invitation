{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invitation.local/schemas/task-queue.schema.json",
  "title": "Invitation task queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "phase",
          "status",
          "summary",
          "acceptanceCriteria",
          "outOfScope",
          "dependsOn",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "IMPLEMENTING",
              "TESTING",
              "ANTISLOP_REVIEW",
              "CHATGPT_REVIEW",
              "FIX_REQUIRED",
              "REVALIDATING",
              "APPROVED",
              "MERGED",
              "NEXT_PHASE"
            ]
          },
          "summary": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "outOfScope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
